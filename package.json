{
  "name": "jp-estoque",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /code/html/index.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open /code/html/index.html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && playwright test",
    "test:db": "node db-tests/run.mjs",
    "test:all": "npm test && npm run typecheck && npm run test:db && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "embedded-postgres": "17.11.0-beta.19",
    "jsdom": "^27.1.0",
    "pg": "8.23.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
