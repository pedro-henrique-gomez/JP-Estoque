{
  "name": "jp-estoque",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /code/html/index.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open /code/html/index.html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && playwright test",
    "test:db": "node db-tests/run.mjs",
    "test:all": "npm test && npm run typecheck && npm run test:db && npm run test:browser",
    "test:integration": "node integration-tests/run.mjs",
    "verify:v06": "npm run test:all && npm run test:integration",
    "test:online": "node integration-tests/run.mjs --online-ui",
    "dev:online": "node integration-tests/run.mjs --serve-online",
    "verify:v07": "npm run test:all && npm run test:integration && npm run test:online",
    "dev:online:stop": "node online-tests/stop.mjs",
    "verify:v08": "npm run test:all && npm run test:integration && npm run test:online",
    "verify:v09": "npm run test:all && npm run test:integration && npm run test:online"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "embedded-postgres": "17.11.0-beta.19",
    "jsdom": "^27.1.0",
    "pg": "8.23.1",
    "supabase": "3.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "fflate": "0.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
