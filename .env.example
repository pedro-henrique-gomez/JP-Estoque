# Optional v0.7 development configuration. Default remains demo.
# Copy to .env.development.local only when intentionally using a local stack.
# Never put a service-role/secret key in a VITE_* variable or in source control.
VITE_JP_ONLINE_LOCAL=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# v0.9: optional lower limits; hard ceilings remain enforced.
# VITE_JP_IMPORT_MAX_BYTES=2097152
# VITE_JP_IMPORT_MAX_ROWS=500
# VITE_JP_IMPORT_MAX_COLUMNS=50
